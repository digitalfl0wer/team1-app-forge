# Forge does NOT read .env files itself. This file documents the variable names;
# copy it to .env (gitignored), fill in your values, then load it into the shell
# that runs the tunnel:
#
#   set -a; source .env; set +a
#   forge tunnel -e development
#
# Never put a real key in this file or in any committed file; the repo is public.

# Local tunnel only: Forge exposes FORGE_USER_VAR_<NAME> to the app as process.env.<NAME>.
FORGE_USER_VAR_OPENROUTER_API_KEY=
# Optional: 1 = mock OpenRouter (no network, no cost). Leave empty for real calls.
FORGE_USER_VAR_AI_MOCK=

# Deployed app (not a .env value; encrypted Forge variable, paste the key at the prompt):
#   forge variables set --encrypt -e development OPENROUTER_API_KEY
# Redeploy after setting it.
