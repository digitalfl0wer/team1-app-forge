{
  "name": "jira-global-page-ui-kit",
  "version": "1.1.51-next.9",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "tsc && npm run build:frame",
    "build:frame": "npm --prefix src/frame run build",
    "watch:frame": "npm --prefix src/frame run watch",
    "deploy": "npm run build && forge deploy --non-interactive --e development",
    "lint": "eslint src --ext .js,.jsx,.ts,.tsx",
    "type-check": "tsc --noEmit && npm --prefix src/frame run type-check"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "@types/react": "^18.2.0",
    "eslint": "^8.56.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "typescript": "5.9.2"
  },
  "dependencies": {
    "@forge/bridge": "7.2.0-next.8",
    "@forge/react": "12.3.1-next.3",
    "@forge/resolver": "2.0.1-next.0",
    "@forge/sql": "^4.0.7",
    "react": "^18.2.0"
  },
  "allowScripts": {
    "iframe-resizer@4.4.5": true
  }
}
